{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:triz-agent-protocol:schema:analysis:0.1",
  "title": "TRIZ analysis artifact",
  "type": "object",
  "required": ["protocol_version", "mode", "problem", "goal", "ifr", "claims", "contradictions", "resources", "solutions", "verification"],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "mode": {"enum": ["lite", "analysis", "ariz-guided"]},
    "problem": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "ifr": {"type": "string", "minLength": 1},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "kind", "statement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["evidence", "inference", "assumption", "simulation"]},
          "statement": {"type": "string", "minLength": 1},
          "source": {"type": ["string", "null"]}
        }, "additionalProperties": false
      }
    },
    "functions": {"type": "array", "items": {"type": "object"}},
    "causes": {"type": "array", "items": {"type": "object"}},
    "contradictions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["type", "element", "requirement_a", "requirement_b"],
        "properties": {
          "type": {"enum": ["administrative", "technical", "physical"]},
          "element": {"type": "string", "minLength": 1},
          "requirement_a": {"type": "string", "minLength": 1},
          "requirement_b": {"type": "string", "minLength": 1},
          "operational_zone": {"type": ["string", "null"]},
          "operational_time": {"type": ["string", "null"]}
        }, "additionalProperties": false
      }
    },
    "resources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "solutions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["id", "concept", "mechanism", "risks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "concept": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "risks": {"type": "array", "items": {"type": "string"}},
          "scores": {"type": "object"}
        }, "additionalProperties": false
      }
    },
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recommended_next_step": {"type": ["string", "null"]},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
